# Copia questo file in .env e cambia TUTTI i valori.
POSTGRES_PASSWORD=cambia-questa-password-lunga
# Segreto JWT: almeno 32 caratteri casuali (openssl rand -hex 32)
JWT_SECRET=cambia-questo-segreto-di-almeno-32-caratteri
# URL pubblico dell'app (frontend)
SITE_URL=https://app.tuodominio.it
# URL pubblico delle API (Kong)
API_EXTERNAL_URL=https://api.tuodominio.it
